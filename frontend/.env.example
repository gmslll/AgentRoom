# Base URL of the AgentRoom backend API.
# Local backend default (routes are served at the root, e.g. /v1/auth/login):
VITE_API_BASE_URL=http://127.0.0.1:8787
# Feature switches. Each must match a backend capability that is actually
# configured, otherwise the UI shows entry points that fail at runtime:
VITE_ENABLE_EMAIL_AUTH=false # 邮箱验证 / 忘记密码 / 修改密码(后端 MAIL_DRIVER=log 时验证码打在服务日志)
VITE_ENABLE_GOOGLE_OAUTH=false
VITE_ENABLE_GITHUB_OAUTH=false
VITE_ENABLE_MODERATION=false # 房间内容审核规则
# Production backend is served under an /api prefix behind a reverse proxy:
# VITE_API_BASE_URL=https://try-status.online/api
