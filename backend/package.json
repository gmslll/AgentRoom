{
  "name": "@agentroom/bridge",
  "version": "0.6.4",
  "description": "Local Claude Code and Codex bridges for AgentRoom",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gmslll/AgentRoom.git",
    "directory": "backend"
  },
  "type": "module",
  "files": [
    "dist/connectors",
    "dist/protocol",
    "README.md",
    "bridge.env.example"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agentroom": "dist/connectors/cli.js",
    "agentroom-claude-channel": "dist/connectors/claude/channel.js",
    "agentroom-codex-bridge": "dist/connectors/codex/bridge.js"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "start": "node dist/api/server.js",
    "db:migrate": "tsx src/database/migrate.ts",
    "build": "tsc -p tsconfig.build.json && npm run cli:package",
    "cli:package": "node scripts/build-cli-release.mjs",
    "bridge:claude": "tsx src/connectors/claude/channel.ts",
    "bridge:codex": "tsx src/connectors/codex/bridge.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
    "@aws-sdk/s3-request-presigner": "^3.1103.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@napi-rs/keyring": "^1.3.0",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.11.2",
    "ioredis": "^6.0.0",
    "nodemailer": "^9.0.4",
    "pg": "^8.22.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.4",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
