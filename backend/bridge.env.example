AGENTROOM_BASE_URL=http://127.0.0.1:8787
AGENTROOM_ROOM_ID=room_replace_me
AGENTROOM_ACCESS_TOKEN=art_replace_me
AGENTROOM_HTTP_TIMEOUT_MS=15000
AGENTROOM_SOCKET_CONNECT_TIMEOUT_MS=15000
AGENTROOM_RECOVERY_INTERVAL_MS=15000

# Codex Bridge only
AGENTROOM_WORKSPACE=/absolute/path/to/project
# AGENTROOM_STATE_FILE=/absolute/path/to/private/state.json
# AGENTROOM_CODEX_COMMAND=codex
# AGENTROOM_CODEX_REQUEST_TIMEOUT_MS=30000
# AGENTROOM_CODEX_TURN_TIMEOUT_MS=1800000

# Store the member token in the OS credential store (macOS Keychain, Windows
# Credential Manager, Linux libsecret) instead of the config file.
# Also settable per command with `agentroom join --credential-store keychain`.
# AGENTROOM_CREDENTIAL_STORE=keychain
