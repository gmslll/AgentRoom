HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://127.0.0.1:8787
# DATABASE_URL=postgresql://agentroom:agentroom@127.0.0.1:5432/agentroom
AUTH_SESSION_TTL_DAYS=30

# Realtime / rate limiting / presence. Omit to run single-process without Redis.
REDIS_URL=redis://127.0.0.1:6379

# S3-compatible object storage (MinIO for local development).
# Start local infra with: powershell -File scripts/dev-infra.ps1
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=agentroom
S3_SECRET_ACCESS_KEY=agentroom-dev-password
S3_BUCKET=agentroom
S3_FORCE_PATH_STYLE=true
FILES_ENABLED=true
FILES_MAX_SIZE_BYTES=104857600
FILES_ROOM_QUOTA_BYTES=1073741824
# Simulated antivirus outcome on upload completion: clean | flagged
FILES_SCAN_RESULT=clean
FILES_UPLOAD_URL_TTL_SECONDS=300

# Mail delivery. driver=log prints emails to the server log (development).
MAIL_DRIVER=log
MAIL_FROM=AgentRoom <no-reply@agentroom.local>
SMTP_HOST=127.0.0.1
SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
MAIL_CODE_TTL_MINUTES=15

# OAuth sign-in (both providers optional; omit to disable).
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_STATE_TTL_SECONDS=600
# Where OAuth callbacks redirect after success (the web client origin).
FRONTEND_URL=http://localhost:3000

# Content moderation (substring rules per room) and remote MCP.
MODERATION_ENABLED=true
MCP_ENABLED=true
